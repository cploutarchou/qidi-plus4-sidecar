[Unit]
Description=Restart go2rtc container for QIDI camera reconnection
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/home/chris/qidi-sidecar
ExecStartPre=/sbin/rmmod uvcvideo
ExecStartPre=/bin/sleep 1
ExecStartPre=/sbin/modprobe uvcvideo
ExecStartPre=/bin/sleep 2
ExecStart=/usr/bin/docker restart qidi_go2rtc
RemainAfterExit=no

[Install]
WantedBy=multi-user.target

# syntax=docker/dockerfile:1

# Linux ARM-focused base image for Raspberry Pi 4/5
ARG GO2RTC_VERSION=latest
FROM alexxit/go2rtc:${GO2RTC_VERSION}

LABEL maintainer="QIDI Plus 4 Sidecar"
LABEL description="go2rtc container for Linux ARM devices (Raspberry Pi 4/5)"
LABEL org.opencontainers.image.source="https://github.com/cploutarchou/qidi-plus4-sidecar"

# Optional custom entrypoint that logs missing video device errors
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod 755 /usr/local/bin/entrypoint.sh

WORKDIR /config
EXPOSE 1984 8554 8555

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["go2rtc", "-config", "/config/go2rtc.yaml"]

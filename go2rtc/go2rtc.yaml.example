# go2rtc configuration for QIDI Plus 4
# WebRTC and streaming server
#
# Copy this file to go2rtc.yaml before running docker-compose up
# See: https://github.com/AlexxIT/go2rtc

streams:
  qidi_plus4:
    # Direct MJPEG capture from USB webcam at high quality
    # NOTE: Ensure /dev/video0 is mapped correctly in docker-compose.yml
    # - input_format: Use 'mjpeg' if your camera supports it, otherwise 'yuyv422'
    # - video_size: Resolution of your camera (e.g., 1920x1080, 1280x720)
    # - framerate: Lower FPS improves stability on USB cameras (25 recommended, 30 for better motion)
    # - i /dev/video0: USB camera device (verify with: ls -la /dev/video*)
    - "exec:ffmpeg -hide_banner -loglevel error -f v4l2 -input_format mjpeg -video_size 1920x1080 -framerate 30 -i /dev/video0 -c:v mjpeg -q:v 2 -f mjpeg -"
    
  qidi_plus4_h264:
    # H.264 stream for WebRTC/RTSP optimized for Linux ARM boards (Raspberry Pi 4/5)
    # Default encoder is libx264 for broad compatibility.
    # On systems with supported hardware encoders, you can switch to h264_v4l2m2m.
    - "exec:ffmpeg -hide_banner -loglevel error -rtsp_transport tcp -i rtsp://127.0.0.1:8554/qidi_plus4 -c:v libx264 -preset veryfast -tune zerolatency -b:v 6M -maxrate 8M -bufsize 12M -g 60 -bf 0 -profile:v high -pix_fmt yuv420p -f h264 -"

# RTSP server (camera access via: rtsp://localhost:8554/qidi_plus4 or rtsp://localhost:8554/qidi_plus4_h264)
rtsp:
  listen: ":8554"

# WebRTC server (low-latency browser streaming)
webrtc:
  listen: ":8555"

# HTTP API server (used by Mainsail and Obico for stream access)
# Access snapshots: http://localhost:1984/api/frame.jpeg?src=qidi_plus4
# Access MJPEG: http://localhost:1984/api/stream.mjpeg?src=qidi_plus4
api:
  listen: ":1984"

# Logging level: debug, info, warn, error
log:
  level: info
